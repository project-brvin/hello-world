{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "gogoitv",
  "main": "src/index.js",
  "compatibility_date": "2026-11-07",
  "workers_dev": true,
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "invocation_logs": true,
      "head_sampling_rate": 1
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.1
    }
  }
}
